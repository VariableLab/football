# Copy this to .env and fill in your values
# Generate SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<generate-with-secrets-token_urlsafe-48>

# Production CORS origins (comma-separated, e.g. https://yourdomain.com,https://www.yourdomain.com)
ALLOWED_ORIGINS=https://yourdomain.com

# HTTPS enforcement (set to 0 to disable, e.g. behind a load balancer that handles TLS)
ENFORCE_HTTPS=1

# Debug mode (set to true for development, false for production)
DEBUG=false

# Stripe (optional — for automatic payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Odds API (the-odds-api.com) — Free: 500 credits/mo
ODDS_API_KEY=<your-odds-api-key>

# football-data.org API (recent form data collection + result sync)
FOOTBALL_DATA_API_KEY=<your-football-data-api-key>

# Admin API Key (for OpenClaw / management scripts)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=<generate-with-secrets-token_urlsafe-32>
